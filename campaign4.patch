    def _design_seed(self, design: dict, salt: str = "") -> int:
        key = json.dumps({k: round(float(design[k]), 10)
                          for k in sorted(design)}) + salt
        return (zlib.crc32(key.encode()) % (2**31 - 1)) + 1

